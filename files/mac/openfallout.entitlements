<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Entitlements for OpenFallout.app (the game), applied with the hardened runtime when the package is signed with a
    Developer ID identity. Plug-ins and libraries inside the bundle take these from the process that loads them.
    Never add com.apple.security.get-task-allow here: it must not be present in a release.
-->
<plist version="1.0">
<dict>
    <!--
        LUAJIT ENTITLEMENT: the entitlement LuaJIT needs under the hardened runtime goes here, once decided
        (com.apple.security.cs.allow-jit with a LUAJIT_ENABLE_OSX_HRT build, or
        com.apple.security.cs.allow-unsigned-executable-memory with today's build).
    -->
</dict>
</plist>
