#include <components/version/version.hpp>

#include <filesystem>
#include <fstream>

namespace Version
{
    std::string_view getVersion()
    {
        return "@OPENFALLOUT_VERSION@";
    }

    std::string_view getCommitHash()
    {
        return "@OPENFALLOUT_VERSION_COMMITHASH@";
    }

    std::string_view getTagHash()
    {
        return "@OPENFALLOUT_VERSION_TAGHASH@";
    }

    int getLuaApiRevision()
    {
        return @OPENFALLOUT_LUA_API_REVISION@;
    }

    int getPostprocessingApiRevision()
    {
        return @OPENFALLOUT_POSTPROCESSING_API_REVISION@;
    }

    std::string getOpenmwVersionDescription()
    {
        std::string str = "OpenFallout version ";
        str += getVersion();
        if (!getCommitHash().empty())
        {
            str += "\nRevision: ";
            str += getCommitHash().substr(0, 10);
        }
        return str;
    }

    bool checkResourcesVersion(const std::filesystem::path& resourcePath)
    {
        std::ifstream stream(resourcePath / "version");
        std::string version, commitHash, tagHash;
        std::getline(stream, version);
        std::getline(stream, commitHash);
        std::getline(stream, tagHash);
        return getVersion() == version && getCommitHash() == commitHash && getTagHash() == tagHash;
    }

    std::string_view getDocumentationUrl()
    {
        if constexpr (std::string_view("@OPENFALLOUT_VERSION_COMMITHASH@") == "@OPENFALLOUT_VERSION_TAGHASH@")
            return "@OPENFALLOUT_DOC_BASEURL@openmw-@OPENFALLOUT_VERSION_MAJOR@.@OPENFALLOUT_VERSION_MINOR@.@OPENFALLOUT_VERSION_RELEASE@/";
        else
            return "@OPENFALLOUT_DOC_BASEURL@latest/";
    }
}
